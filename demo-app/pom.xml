<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.javelin</groupId>
        <artifactId>javelin-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>javelin-demo-app</artifactId>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <http.driver>netty</http.driver>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-cache-valkey</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-queue-nats</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-exception</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-json-jackson</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-validation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-cache-caffeine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-storage</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-queue</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-queue-file</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-events</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-scheduler</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-mail</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-provider-loader</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-observability</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-deployment</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
    </dependencies>
    <build>
        <sourceDirectory>.</sourceDirectory>
        <testSourceDirectory>tests</testSourceDirectory>
        <resources>
            <resource>
                <directory>.</directory>
                <filtering>true</filtering>
                <includes>
                    <include>config/**</include>
                </includes>
            </resource>
            <resource>
                <directory>.</directory>
                <filtering>false</filtering>
                <includes>
                    <include>logback.xml</include>
                    <include>logback-prod.xml</include>
                    <include>errors/**</include>
                    <include>routes/**</include>
                    <include>resources/**</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>Main.java</include>
                        <include>routes/**/*.java</include>
                        <include>app/**/*.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>driver-netty</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <http.driver>netty</http.driver>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.javelin</groupId>
                    <artifactId>javelin-http-netty</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>driver-jdk</id>
            <properties>
                <http.driver>jdk</http.driver>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.javelin</groupId>
                    <artifactId>javelin-http-jdk</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>driver-undertow</id>
            <properties>
                <http.driver>undertow</http.driver>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.javelin</groupId>
                    <artifactId>javelin-http-undertow</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
