<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Something went wrong</title>
    <style>
        body { margin: 0; font-family: system-ui, sans-serif; background: #f6f7f9; color: #1f2937; }
        main { max-width: 720px; margin: 8rem auto; padding: 2rem; background: white; border: 1px solid #e5e7eb; border-radius: 1rem; }
        code { color: #6b7280; }
    </style>
</head>
<body>
<main>
    <p><code>500</code></p>
    <h1>Something went wrong</h1>
    <p>We could not complete your request. Please try again shortly.</p>
</main>
</body>
</html>
