app:
  name: {{ project }}
  env: ${APP_ENV:local}

server:
  host: ${SERVER_HOST:127.0.0.1}
  port: ${SERVER_PORT:8080}
  static_dir: public
  static_cache_seconds: 3600
  static_cache_immutable: false
  static_after_routes: false
  request_timeout_seconds: 30
  idle_timeout_seconds: 60

database:
  default: primary
  migrations_dir: database/migrations
  query:
    timing: true
    slow_ms: 100
    log_all: false
  connections:
    primary:
      driver: postgresql
      host: ${DATABASE_HOST:localhost}
      port: ${DATABASE_PORT:5432}
      database: ${DATABASE_NAME:{{ project }}}
      username: ${DATABASE_USERNAME:postgres}
      password: ${DATABASE_PASSWORD:secret}
      max_pool_size: 10
      minimum_idle: 2
      connection_timeout_ms: 5000
      idle_timeout_ms: 300000
      max_lifetime_ms: 1800000

cache:
  driver: ${CACHE_DRIVER:memory}
  url: ${VALKEY_URL:}
  caffeine:
    maximum_size: 10000
    default_ttl_seconds: 0

storage:
  upload_dir: storage/uploads
  default: public
  disks:
    public:
      driver: local
      root: storage/app/public
      domain: /files/
      max_bytes: 10485760
      allowed_extensions:
        - txt
        - png
        - jpg
        - pdf
    private:
      driver: local
      root: storage/app/private
      domain: /files/
      public: false
    temporary:
      driver: local
      root: storage/app/tmp
      domain: /files/

queue:
  driver: ${QUEUE_DRIVER:file}
  url: ${NATS_URL:nats://localhost:4222}
  worker:
    enabled: true
    concurrency: 4
    poll_interval_ms: 500
    lease_seconds: 60
    timeout_seconds: 300
    shutdown_seconds: 10
  retry:
    backoff: exponential
    initial_ms: 1000
    max_ms: 60000
  database:
    lease_seconds: 60
  file:
    dir: storage/queues/file
  valkey:
    url: ${VALKEY_URL:redis://valkey:6379}
  rabbitmq:
    uri: ${RABBITMQ_URI:amqp://guest:guest@localhost:5672/%2F}
  stream: ${NATS_STREAM:JAVELIN}

json:
  indent_output: false
  fail_on_unknown_properties: false
  write_nulls: true
  date_format: ""

session:
  cookie_name: javelin_session
  ttl_seconds: 1800
  secure: true
  http_only: true
  same_site: Lax

log:
  channel: console
  path: storage/logs/app.log
  request_logging: true
  request_id_header: X-Request-ID
  correlation_id_header: X-Correlation-ID
  level:
    root: INFO
    io:
      netty: WARN
    org:
      xnio: WARN

errors:
  redact: true
  pages_dir: errors
  redact_keys:
    - password
    - token
    - authorization
    - cookie
    - api_key

security:
  max_request_bytes: 1048576
  trusted_proxies:
    - 127.0.0.1
    # Docker's default bridge network; needed when running behind nginx/Caddy.
    - 172.16.0.0/12
  password:
    hash: pbkdf2
    bcrypt_cost: 12
  jwt:
    secret: ${APP_KEY:change-me}
    issuer: ""
    audience: ""
    ttl_seconds: 3600
  hsts:
    enabled: false
  csp: ""

# Empty origins means CORS is disabled; add exact origins to opt in.
cors:
  allowed_origins: []
  allow_credentials: false
  max_age_seconds: 600

secrets:
  dir: secrets

mail:
  driver: test
  from: no-reply@example.com
  test:
    dir: storage/mail
  smtp:
    default:
      host: ${SMTP_HOST:}
      port: 587
      username: ${SMTP_USERNAME:}
      password: ${SMTP_PASSWORD:}
      auth: true
      starttls: true
  retry:
    max_attempts: 3
    backoff_ms: 1000

scheduler:
  enabled: true
  poll_interval_ms: 1000
  lock_ttl_seconds: 120
  timezone: UTC
  owner: ${HOSTNAME:javelin}
  history: memory
  lock: memory

observability:
  enabled: true
  health_path: /health
  ready_path: /ready
  metrics_path: /metrics
  tracing: none

provider:
  directory: modules
  strict: false
  enabled: []
  disabled: []

providers:
  - app.providers.AppServiceProvider
  - io.javelin.json.jackson.JacksonJsonServiceProvider
  - io.javelin.exception.ExceptionHandlerServiceProvider
  - io.javelin.security.SessionServiceProvider
  - io.javelin.security.SessionAuthServiceProvider
  - io.javelin.security.JwtAuthServiceProvider
  - io.javelin.security.CorsServiceProvider
  - io.javelin.validation.ValidationServiceProvider
  - io.javelin.config.SecretsServiceProvider
  - io.javelin.storage.StorageServiceProvider
  - io.javelin.cache.caffeine.CaffeineCacheServiceProvider
  - io.javelin.cache.valkey.ValkeyCacheServiceProvider
  - io.javelin.events.EventServiceProvider
  - io.javelin.scheduler.SchedulerServiceProvider
  - io.javelin.mail.MailServiceProvider
  - io.javelin.providers.ProviderRegistryServiceProvider
  - io.javelin.observability.ObservabilityServiceProvider
  - io.javelin.queue.QueueServiceProvider
  - io.javelin.queue.file.FileQueueServiceProvider
  - io.javelin.queue.database.DatabaseQueueServiceProvider
  - io.javelin.queue.valkey.ValkeyQueueServiceProvider
  - io.javelin.queue.rabbitmq.RabbitMqQueueServiceProvider
  - io.javelin.queue.nats.NatsQueueServiceProvider

javelin:
  starter:
    http-driver: netty
