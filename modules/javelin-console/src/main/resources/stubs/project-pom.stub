<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>app</groupId>
    <artifactId>{{ project }}</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javelin.version>0.1.0-SNAPSHOT</javelin.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <!-- Application code consumes the framework as a normal Maven dependency. -->
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-starter</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <!-- Default HTTP driver. Swap for javelin-http-jdk or javelin-http-undertow
             and update javelin.starter.http-driver in config/app.yaml if needed. -->
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-http-netty</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <!-- Configurable Jackson mapping for JSON responses and parsing. -->
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-json-jackson</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <!-- Explicit input validation rules. -->
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-validation</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <!-- Centralized exception handling with redaction and custom error pages. -->
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-exception</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <!-- YAML migrations with dialect-aware history tables. -->
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-db-migration</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <!-- Fast local cache and unified file storage. -->
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-cache-caffeine</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-storage</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <!-- Explicit service providers for the cache and queue backends. -->
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-cache-valkey</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-queue-nats</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <!-- Broker-free queue plus optional backends. -->
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-queue</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-queue-file</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-queue-database</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-queue-valkey</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-queue-rabbitmq</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-queue-nats</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <!-- Scheduler and event dispatcher. -->
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-scheduler</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <dependency>
            <groupId>io.javelin</groupId>
            <artifactId>javelin-events</artifactId>
            <version>${javelin.version}</version>
        </dependency>
        <!-- Add workspace-specific application libraries below this line. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>.</sourceDirectory>
        <testSourceDirectory>tests</testSourceDirectory>
        <resources>
            <resource>
                <directory>.</directory>
                <includes>
                    <include>logback.xml</include>
                    <include>logback-prod.xml</include>
                    <include>config/**</include>
                    <include>errors/**</include>
                    <include>routes/**</include>
                    <include>resources/**</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <includes>
                        <include>Main.java</include>
                        <include>app/**/*.java</include>
                        <include>modules/**/*.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <version>0.10.4</version>
                <configuration>
                    <imageName>{{ project }}</imageName>
                    <mainClass>Main</mainClass>
                    <buildArgs>
                        <buildArg>--no-fallback</buildArg>
                    </buildArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
