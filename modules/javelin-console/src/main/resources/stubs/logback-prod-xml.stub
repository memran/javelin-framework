<configuration>
    <!-- Production logging: one JSON object per line on stdout and in a rotating file.
         Levels can also be set with log.level.* keys in config/app.yaml. -->

    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="io.javelin.log.slf4j.JsonLogEncoder"/>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-storage/logs/app.log}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-storage/logs/app.log}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="io.javelin.log.slf4j.JsonLogEncoder"/>
    </appender>

    <logger name="io.netty" level="WARN"/>
    <logger name="io.undertow" level="WARN"/>
    <logger name="org.xnio" level="WARN"/>
    <logger name="org.jboss.threads" level="WARN"/>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="CONSOLE_JSON"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
