<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.javelin</groupId>
    <artifactId>javelin-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Javelin Framework</name>

    <modules>
        <module>modules/javelin-core</module>
        <module>modules/javelin-config</module>
        <module>modules/javelin-http-common</module>
        <module>modules/javelin-http-jdk</module>
        <module>modules/javelin-http-netty</module>
        <module>modules/javelin-http-undertow</module>
        <module>modules/javelin-db-jdbc</module>
        <module>modules/javelin-db-migration</module>
        <module>modules/javelin-log-slf4j</module>
        <module>modules/javelin-exception</module>
        <module>modules/javelin-view-pebble</module>
        <module>modules/javelin-storage</module>
        <module>modules/javelin-json-jackson</module>
        <module>modules/javelin-console</module>
        <module>modules/javelin-security</module>
        <module>modules/javelin-validation</module>
        <module>modules/javelin-support</module>
        <module>modules/javelin-cache</module>
        <module>modules/javelin-cache-valkey</module>
        <module>modules/javelin-cache-caffeine</module>
        <module>modules/javelin-queue</module>
        <module>modules/javelin-events</module>
        <module>modules/javelin-scheduler</module>
        <module>modules/javelin-mail</module>
        <module>modules/javelin-provider-loader</module>
        <module>modules/javelin-queue-rabbitmq</module>
        <module>modules/javelin-queue-valkey</module>
        <module>modules/javelin-queue-file</module>
        <module>modules/javelin-queue-database</module>
        <module>modules/javelin-queue-nats</module>
        <module>modules/javelin-starter</module>
        <module>demo-app</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jackson.version>2.18.2</jackson.version>
        <junit.version>5.11.4</junit.version>
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.5.16</logback.version>
        <netty.version>4.2.1.Final</netty.version>
        <undertow.version>2.3.18.Final</undertow.version>
        <lettuce.version>6.4.0.RELEASE</lettuce.version>
        <jnats.version>2.20.0</jnats.version>
        <postgresql.version>42.7.4</postgresql.version>
        <mysql.version>9.2.0</mysql.version>
        <mariadb.version>3.5.3</mariadb.version>
        <sqlite.version>3.49.1.0</sqlite.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>io.lettuce</groupId>
                <artifactId>lettuce-core</artifactId>
                <version>${lettuce.version}</version>
            </dependency>
            <dependency>
                <groupId>io.nats</groupId>
                <artifactId>jnats</artifactId>
                <version>${jnats.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
